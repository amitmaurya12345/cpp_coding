#include<bits/stdc++.h>
using namespace std;
int main(){
int n;cin>>n;
bool isPrime=true;
if(n<=1){
    cout<<"It is not prime number.";
    return 0;
    }
if(n==2) {cout<<"It is prime number."; return 0;}
if(n%2==0){cout<<"It is not prime number."; return 0;}

for(int i=3;i*i<=n;i+=2){
   if(n%i==0){ 
      isPrime=false;
      break;}
   }
   isPrime ? cout<<"It is prime number.": cout<<"It is not prime number.";
   return 0;
   }
