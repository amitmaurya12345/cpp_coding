#include<bits/stdc++.h>
using namespace std;
int main(){
int n;cin>>n;
bool isPrime=true;
if(n<=1){
    cout<<"It is not prime number.";
    return 0;
    }
for(int i=2;i*i<=n;i++){
   if(n%i==0){ 
      isPrime=false;
      break;}
   }
   isPrime ? cout<<"It is prime number.": cout<<"It is not prime number";
   return 0;
   }
